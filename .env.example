# FACTORY Data Platform Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Environment Settings
# =============================================================================
# Environment: local, dev, or prod
FABRIC_ENVIRONMENT=local
LOG_LEVEL=INFO
DATA_PATH=./data

# =============================================================================
# Repository Paths (for consolidation)
# =============================================================================
FABRIC_SCRAPERS_UNIFIED_PATH=~/OneDrive/Scripts/scrapers_unified
FABRIC_WAREHOUSE_PATH=~/OneDrive/Scripts/warehouse

# =============================================================================
# Warehouse Database
# =============================================================================
WAREHOUSE_DB_NAME=procurement_warehouse
WAREHOUSE_DB_USER=warehouse_user
WAREHOUSE_DB_PASSWORD=change_me_in_production
WAREHOUSE_DB_HOST=warehouse_db
WAREHOUSE_DB_PORT=5432

# Legacy PostgreSQL settings (for backwards compatibility)
FABRIC_WAREHOUSE_DB_HOST=localhost
FABRIC_WAREHOUSE_DB_PORT=5432
FABRIC_WAREHOUSE_DB_NAME=dc_analytics
FABRIC_WAREHOUSE_DB_USER=postgres
FABRIC_WAREHOUSE_DB_PASSWORD=

# =============================================================================
# Redis Cache
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# External APIs (optional)
# =============================================================================
RAPIDAPI_KEY=
RENTCAST_API_KEY=

# =============================================================================
# Scraper Settings
# =============================================================================
DEFAULT_RATE_LIMIT=2.0
MAX_CONCURRENT_SOURCES=3
INCREMENTAL_LOAD=true
DEMO_MODE=true

# =============================================================================
# Quality Thresholds
# =============================================================================
FABRIC_MAX_NULL_RATE_WARNING=0.3
FABRIC_MAX_NULL_RATE_ERROR=0.5
